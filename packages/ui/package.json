{
  "name": "@easm-ui/ui",
  "version": "3.14.0",
  "description": "EASM One React components: the honey milk design system for EASM products.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easm-ui/design-system.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src/**/*.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./tailwind.css": "./src/tailwind.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/esm-extensions.mjs dist",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node test/components/verify-components.cjs && node test/stylesheet.cjs && node test/palette.cjs",
    "test:a11y": "node test/a11y.cjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@easm-ui/brand": "workspace:^",
    "@easm-ui/icons": "workspace:^",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tooltip": "1.2.16"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "axe-core": "4.14.0",
    "css-tree": "3.2.1",
    "esbuild": "0.25.12",
    "jsdom": "30.1.1",
    "postcss": "8.5.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "~5.9.3"
  },
  "homepage": "https://github.com/easm-ui/design-system/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/easm-ui/design-system/issues"
  }
}
