{
  "name": "easm-ui-design-system",
  "private": true,
  "version": "1.0.0",
  "description": "EASM UI: the EASM One design system (tokens, React components, icons and brand kit)",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:a11y": "pnpm --filter @easm-ui/ui test:a11y",
    "test:icon-motion": "pnpm --filter @easm-ui/icons test:motion",
    "tokens": "node tokens/build.mjs",
    "tokens:check": "node tokens/build.mjs --check",
    "check": "pnpm tokens:check && pnpm build && pnpm lint && pnpm test && pnpm test:a11y && pnpm test:icon-motion",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "release:tag": "changeset git-tag"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "playwright-core": "1.62.1",
    "prettier": "3.6.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "style-dictionary": "5.6.1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easm-ui/design-system.git"
  }
}
